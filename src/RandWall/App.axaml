<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="RandWall.App"
             RequestedThemeVariant="Dark">
  <Application.Resources>
    <FontFamily x:Key="AppFontFamily">Inter, Microsoft YaHei UI, Segoe UI</FontFamily>

    <!-- 覆盖 Fluent 强调色，让滑块、开关、选中态统一为园林绿 -->
    <Color x:Key="SystemAccentColor">#48C08D</Color>
    <Color x:Key="SystemAccentColorLight1">#5FD3A3</Color>
    <Color x:Key="SystemAccentColorLight2">#7BE0B8</Color>
    <Color x:Key="SystemAccentColorLight3">#A5EDCF</Color>
    <Color x:Key="SystemAccentColorDark1">#3AA97A</Color>
    <Color x:Key="SystemAccentColorDark2">#2E8A62</Color>
    <Color x:Key="SystemAccentColorDark3">#226B4B</Color>

    <SolidColorBrush x:Key="BgDeep" Color="#0A100D" />
    <SolidColorBrush x:Key="BgSidebar" Color="#0B120F" />
    <SolidColorBrush x:Key="BgCard" Color="#111A16" />
    <SolidColorBrush x:Key="BgCardSoft" Color="#0E1713" />
    <SolidColorBrush x:Key="Stroke" Color="#1C2923" />
    <SolidColorBrush x:Key="StrokeSoft" Color="#16221C" />
    <SolidColorBrush x:Key="TextPrimary" Color="#E9F2EC" />
    <SolidColorBrush x:Key="TextSecondary" Color="#8CA396" />
    <SolidColorBrush x:Key="TextMuted" Color="#5F7368" />
    <SolidColorBrush x:Key="Accent" Color="#48C08D" />
    <SolidColorBrush x:Key="AccentSoft" Color="#1E3B2F" />
    <SolidColorBrush x:Key="Danger" Color="#E4715E" />
  </Application.Resources>

  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://RandWall/Styles/AppStyles.axaml" />
  </Application.Styles>
</Application>
